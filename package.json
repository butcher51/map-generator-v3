{
  "name": "map-generator-v3",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Seeded vanilla-JS map generator with an AI dev-workflow pipeline dashboard.",
  "scripts": {
    "dev": "http-server . -p 4173 -c-1",
    "test:unit": "vitest run --coverage",
    "test:watch": "vitest",
    "test:smoke": "playwright test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "validate": "html-validate index.html dashboard/index.html",
    "verify": "npm run test:unit && npm run lint && npm run validate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "html-validate": "^11.13.0",
    "http-server": "^14.1.1",
    "prettier": "^3.9.6",
    "vitest": "^4.1.11"
  }
}
